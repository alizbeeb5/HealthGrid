{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthGrid API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/facilities": {
      "get": {
        "tags": [
          "facilities"
        ],
        "summary": "List Facilities",
        "operationId": "list_facilities",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilityListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/facilities/{facility_id}/snapshot": {
      "get": {
        "tags": [
          "facilities"
        ],
        "summary": "Get Facility Snapshot",
        "operationId": "get_facility_snapshot",
        "parameters": [
          {
            "name": "facility_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Facility Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilitySnapshotResponse"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/facilities/{facility_id}/observations": {
      "post": {
        "tags": [
          "facilities"
        ],
        "summary": "Create Resource Observation",
        "operationId": "create_resource_observation",
        "parameters": [
          {
            "name": "facility_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Facility Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capacity/facilities/{facility_id}": {
      "get": {
        "tags": [
          "capacity"
        ],
        "summary": "Get Facility Capacity",
        "description": "Modeled single-service capacity from reported resources.\n\nA resource-based estimate under demo requirement profiles, not confirmed spare\nadmission capacity. Unknown capacity is a successful result, not an error.",
        "operationId": "get_facility_capacity",
        "parameters": [
          {
            "name": "facility_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Facility Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilityCapacityResponse"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/network/services": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "List Network Services",
        "operationId": "list_network_services",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkServiceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/network/overview": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Get Network Overview",
        "description": "Modeled single-service capacity for every facility offering the service.\n\nAn unknown service_id returns 200 with service_name null and no facilities.\nEstimates are demo resource-based models, not spare admission capacity.",
        "operationId": "get_network_overview",
        "parameters": [
          {
            "name": "service_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "title": "Service Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkOverviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forecasts/facilities/{facility_id}": {
      "get": {
        "tags": [
          "forecasts"
        ],
        "summary": "Get Facility Forecast",
        "description": "Seven-day modeled capacity and demand forecast for one facility service.\n\nInsufficient history is a successful result with status insufficient_history.\nPredicted gaps are not calibrated shortage probabilities. Synthetic demo data.",
        "operationId": "get_facility_forecast",
        "parameters": [
          {
            "name": "facility_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Facility Id"
            }
          },
          {
            "name": "service_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "title": "Service Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilityForecastResponse"
                }
              }
            }
          },
          "404": {
            "description": "Facility does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Process liveness only; does not assert database or AI availability.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapacityStatus": {
        "type": "string",
        "enum": [
          "calculated",
          "unknown",
          "unavailable",
          "not_configured"
        ],
        "title": "CapacityStatus"
      },
      "DataQuality": {
        "type": "string",
        "enum": [
          "reported",
          "estimated"
        ],
        "title": "DataQuality"
      },
      "DataStatus": {
        "type": "string",
        "enum": [
          "current",
          "stale",
          "unknown"
        ],
        "title": "DataStatus"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "facility_not_found",
              "invalid_observation",
              "invalid_request"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "fields"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Facility": {
        "properties": {
          "facility_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Facility Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "last_reported_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Reported At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility_id",
          "name",
          "latitude",
          "longitude",
          "last_reported_at"
        ],
        "title": "Facility"
      },
      "FacilityCapacityResponse": {
        "properties": {
          "facility_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Facility Id"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "stale_after_hours": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Stale After Hours"
          },
          "calculation_scope": {
            "type": "string",
            "const": "single_service",
            "title": "Calculation Scope"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceCapacityResult"
            },
            "type": "array",
            "title": "Services"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility_id",
          "as_of",
          "stale_after_hours",
          "calculation_scope",
          "services"
        ],
        "title": "FacilityCapacityResponse"
      },
      "FacilityForecastResponse": {
        "properties": {
          "facility_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Facility Id"
          },
          "service_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Service Id"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "horizon_days": {
            "type": "integer",
            "const": 7,
            "title": "Horizon Days"
          },
          "capacity_unit": {
            "type": "string",
            "const": "simultaneous_service_place",
            "title": "Capacity Unit"
          },
          "profile_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Version"
          },
          "status": {
            "$ref": "#/components/schemas/ForecastStatus"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryDay"
            },
            "type": "array",
            "title": "History"
          },
          "forecast": {
            "items": {
              "$ref": "#/components/schemas/ForecastDay"
            },
            "type": "array",
            "title": "Forecast"
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/ForecastAlert"
            },
            "type": "array",
            "title": "Alerts"
          },
          "validation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ForecastValidation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility_id",
          "service_id",
          "generated_at",
          "horizon_days",
          "capacity_unit",
          "profile_version",
          "status",
          "history",
          "forecast",
          "alerts",
          "validation"
        ],
        "title": "FacilityForecastResponse"
      },
      "FacilityListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Facility"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "FacilityListResponse"
      },
      "FacilityService": {
        "properties": {
          "facility_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Facility Id"
          },
          "service_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Service Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility_id",
          "service_id",
          "name",
          "status"
        ],
        "title": "FacilityService"
      },
      "FacilitySnapshotResponse": {
        "properties": {
          "facility": {
            "$ref": "#/components/schemas/Facility"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/FacilityService"
            },
            "type": "array",
            "title": "Services"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/ResourceSnapshot"
            },
            "type": "array",
            "title": "Resources"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "stale_after_hours": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Stale After Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility",
          "services",
          "resources",
          "as_of",
          "stale_after_hours"
        ],
        "title": "FacilitySnapshotResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "ForecastAlert": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "code": {
            "type": "string",
            "const": "predicted_gap",
            "title": "Code"
          },
          "expected_gap": {
            "type": "number",
            "minimum": 0.0,
            "title": "Expected Gap"
          },
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "code",
          "expected_gap",
          "message"
        ],
        "title": "ForecastAlert",
        "description": "A predicted gap; not a calibrated shortage probability."
      },
      "ForecastDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "predicted_capacity": {
            "type": "number",
            "minimum": 0.0,
            "title": "Predicted Capacity"
          },
          "predicted_demand": {
            "type": "number",
            "minimum": 0.0,
            "title": "Predicted Demand"
          },
          "capacity_lower": {
            "type": "number",
            "minimum": 0.0,
            "title": "Capacity Lower"
          },
          "capacity_upper": {
            "type": "number",
            "minimum": 0.0,
            "title": "Capacity Upper"
          },
          "demand_lower": {
            "type": "number",
            "minimum": 0.0,
            "title": "Demand Lower"
          },
          "demand_upper": {
            "type": "number",
            "minimum": 0.0,
            "title": "Demand Upper"
          },
          "expected_gap": {
            "type": "number",
            "minimum": 0.0,
            "title": "Expected Gap"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "predicted_capacity",
          "predicted_demand",
          "capacity_lower",
          "capacity_upper",
          "demand_lower",
          "demand_upper",
          "expected_gap"
        ],
        "title": "ForecastDay"
      },
      "ForecastStatus": {
        "type": "string",
        "enum": [
          "forecasted",
          "insufficient_history",
          "not_configured"
        ],
        "title": "ForecastStatus"
      },
      "ForecastValidation": {
        "properties": {
          "method": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Method"
          },
          "holdout_days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Holdout Days"
          },
          "evaluated_from": {
            "type": "string",
            "format": "date",
            "title": "Evaluated From"
          },
          "evaluated_to": {
            "type": "string",
            "format": "date",
            "title": "Evaluated To"
          },
          "capacity_mae": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity Mae"
          },
          "demand_mae": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand Mae"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "method",
          "holdout_days",
          "evaluated_from",
          "evaluated_to",
          "capacity_mae",
          "demand_mae"
        ],
        "title": "ForecastValidation",
        "description": "Error on withheld historical days, in simultaneous service places."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "healthgrid-api",
            "title": "Service",
            "default": "healthgrid-api"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "HistoryDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "capacity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity"
          },
          "demand": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand"
          },
          "sources": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "title": "Sources"
          },
          "data_quality": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DataQuality"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "capacity",
          "demand",
          "sources",
          "data_quality"
        ],
        "title": "HistoryDay"
      },
      "NetworkFacilityResult": {
        "properties": {
          "facility": {
            "$ref": "#/components/schemas/Facility"
          },
          "capacity": {
            "$ref": "#/components/schemas/ServiceCapacityResult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "facility",
          "capacity"
        ],
        "title": "NetworkFacilityResult"
      },
      "NetworkOverviewResponse": {
        "properties": {
          "service_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Service Id"
          },
          "service_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Name"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "stale_after_hours": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
