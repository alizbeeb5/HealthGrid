# Local development only; copy to .env in the repository root.
POSTGRES_DB=healthgrid
POSTGRES_USER=healthgrid
POSTGRES_PASSWORD=healthgrid_local
DATABASE_URL=postgresql+psycopg://healthgrid:healthgrid_local@localhost:5432/healthgrid
# Server-side only. Enables live incident assessment; never expose in web code.
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=gpt-6-luna
# Optional: enables separate Responses field extraction.
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_EMERGENCY_MODEL=gpt-6-luna
OPENAI_INTELLIGENCE_TIMEOUT_SECONDS=15
# Private prototype access gate, verified independently by frontend and backend.
# Use a generated password of at least 16 characters. Never use NEXT_PUBLIC_ for secrets.
APP_ENVIRONMENT=development
SECURITY_USERNAME=healthgrid
SECURITY_PASSWORD=
# Production requires explicit HTTPS origins, credentials, and no Beirut exercise.
SECURITY_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
SECURITY_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Generate an independent random secret (32+ characters) for browser sessions.
SECURITY_SESSION_SECRET=
