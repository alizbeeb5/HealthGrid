{
  "name": "@healthgrid/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=9.5.0"
  },
  "scripts": {
    "sync:facilities": "node scripts/sync-facility-fixtures.mjs && node scripts/sync-capacity-fixtures.mjs && node scripts/sync-network-fixtures.mjs",
    "predev": "npm run sync:facilities",
    "dev": "next dev",
    "prebuild": "npm run sync:facilities",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:facilities": "tsc -p tsconfig.test.json && node --test --experimental-test-isolation=none .test-build/apps/web/tests/facilities.test.js",
    "test:capacity": "tsc -p tsconfig.test.json && node --test --experimental-test-isolation=none .test-build/apps/web/tests/capacity.test.js",
    "test:network": "tsc -p tsconfig.test.json && node --test --experimental-test-isolation=none .test-build/apps/web/tests/network.test.js",
    "generate:api": "openapi-typescript ../../contracts/openapi.json -o src/lib/api/schema.d.ts",
    "generate:feature-1": "openapi-typescript ../../contracts/feature-1.openapi.json -o src/lib/api/feature-1-schema.d.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/leaflet": "^1.9.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "openapi-typescript": "^7.0.0"
  }
}
